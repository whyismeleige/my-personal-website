# Spotify — powers the top artists / top tracks block on /interests.

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Do NOT fill these in by hand. Run the dev server and visit
#   http://127.0.0.1:3000/api/spotify/login
# which writes both values for you. Refresh tokens last 6 months;
# revisit that URL to renew.
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REFRESH_TOKEN_ISSUED=

# Optional. Only needed to run the /api/spotify/* setup routes in production;
# they return 404 there unless this is set and passed as ?key=<value>.
SPOTIFY_SETUP_SECRET=

# Optional. Overrides the auto-derived OAuth callback URL.
# SPOTIFY_REDIRECT_URI=https://your-domain.com/api/spotify/callback

# OMDb — powers the film posters on /interests.
# Free key (1,000 requests a day): https://www.omdbapi.com/apikey.aspx
# Without it the Movies section still lists your films, just without posters.
OMDB_API_KEY=
